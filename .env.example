# Gemini API Keys (Safe Key Rotation)
# Key 1 is used first. If it hits 429 / quota limit, Key 2 is automatically rotated and retried!
VITE_GEMINI_API_KEY_1=your_primary_gemini_api_key_here
VITE_GEMINI_API_KEY_2=your_secondary_gemini_api_key_here

# Optional: Backward compatible single key
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
